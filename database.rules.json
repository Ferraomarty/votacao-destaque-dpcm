{
  "rules": {
    ".read": false,
    ".write": false,
    "config": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'wD1OSyTNWFVG30E8gjm0SBxN7fl2'",
      "fase": {
        ".validate": "newData.isString() && newData.val().matches(/^(fase1|encerrada)$/)"
      },
      "$outro": {
        ".validate": false
      }
    },
    "pessoas": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'wD1OSyTNWFVG30E8gjm0SBxN7fl2'"
    },
    "votaram": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'wD1OSyTNWFVG30E8gjm0SBxN7fl2'",
      "$pid": {
        ".write": "!data.exists() && newData.val() === true && newData.parent().parent().child('votos/' + $pid).exists()"
      }
    },
    "emails": {
      ".read": "auth != null && auth.uid === 'wD1OSyTNWFVG30E8gjm0SBxN7fl2'",
      ".write": "auth != null && auth.uid === 'wD1OSyTNWFVG30E8gjm0SBxN7fl2'",
      "$chave": {
        ".write": "!data.exists() && newData.isString() && newData.parent().parent().child('votos/' + newData.val() + '/email').val().toLowerCase().replace('.', ',') === $chave"
      }
    },
    "votos": {
      ".read": "auth != null && auth.uid === 'wD1OSyTNWFVG30E8gjm0SBxN7fl2'",
      ".write": "auth != null && auth.uid === 'wD1OSyTNWFVG30E8gjm0SBxN7fl2'",
      "$pid": {
        ".write": "!data.exists() && newData.exists() && root.child('config/fase').val() !== 'encerrada' && root.child('pessoas/' + $pid).exists() && newData.parent().parent().child('votaram/' + $pid).val() === true && newData.parent().parent().child('emails/' + newData.child('email').val().toLowerCase().replace('.', ',')).val() === $pid",
        ".validate": "newData.hasChildren(['setor', 'candidato', 'email', 'ts']) && newData.child('setor').val() === root.child('pessoas/' + $pid + '/setor').val() && newData.child('candidato').isString() && newData.child('candidato').val().matches(/^[a-z0-9]+$/) && newData.child('candidato').val() !== $pid && root.child('pessoas/' + newData.child('candidato').val() + '/setor').val() === newData.child('setor').val() && root.child('pessoas/' + newData.child('candidato').val() + '/chefe').val() === false",
        "setor": {
          ".validate": "newData.isString()"
        },
        "candidato": {
          ".validate": "newData.isString()"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9._%+-]+@ins[.]gov[.]mz$/)"
        },
        "ts": {
          ".validate": "newData.val() === now"
        },
        "$outro": {
          ".validate": false
        }
      }
    }
  }
}
